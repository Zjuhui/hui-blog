---
import '../styles/global.css';
import { href, copy, studioMode, type Locale, type settings } from '../lib/site';
import { appearanceVariables, appearanceAttributes } from '../lib/appearance.mjs';
import { resolvePresentation } from '../lib/site-customization.mjs';
interface Props { title: string; description: string; locale: Locale; page: string; counterpart: string; config: Awaited<ReturnType<typeof settings>> }
const { title, description, locale, page, counterpart, config } = Astro.props;
const presentation = resolvePresentation(config);
const { branding, footer } = presentation;
const t = { ...copy[locale], ...presentation.text[locale] };
const hasBrand = (branding.showMark && branding.mark) || (branding.showWordmark && branding.wordmark);
const brandLabel = config.name || [branding.showMark && branding.mark, branding.showWordmark && branding.wordmark].filter(Boolean).join(' ') || copy[locale].home;
const navigation = [['', 'home'], ['archive', 'writing'], ['works', 'works'], ['about', 'about']].filter(([, label]) => t[label as keyof typeof t]);
const socialLinks = config.socialLinks.filter(link => link.label.trim());
const copyrightName = branding.wordmark || config.name;
const hasFooterLeft = (footer.showMark && branding.mark) || t.footer;
const hasFooterRight = socialLinks.length || (footer.showCopyright && copyrightName);
const active = ['archive', 'research', 'life', 'post'].includes(page) ? 'archive' : page;
const canonicalPath = Astro.url.pathname.replace(/^\/hui-blog\/en\//, '/hui-blog/');
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} {...appearanceAttributes(config.appearance)} style={appearanceVariables(config.appearance)}>
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/><meta name="theme-color" content={config.appearance.background}/>
    <title>{title}</title><link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`}/>
    {!studioMode && <link rel="canonical" href={`https://zjuhui.github.io${canonicalPath}`}/>}
    {studioMode && <meta name="robots" content="noindex,nofollow"/>}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    {studioMode && <div class="preview-banner">{t.preview}<a href="/studio/">{t.studio} ↗</a></div>}
    <div class="site-shell">
      <header class:list={['site-header', { 'without-brand': !hasBrand, 'without-navigation': !navigation.length }]}>
        {hasBrand && <a class="brand" href={href('', locale)} aria-label={brandLabel} data-studio-section={studioMode ? 'branding' : undefined}>{branding.showMark && branding.mark && <span class="seal">{branding.mark}</span>}{branding.showWordmark && branding.wordmark && <span class="wordmark">{branding.wordmark}<span class="brand-dot">.</span></span>}</a>}
        {navigation.length > 0 && <nav aria-label={locale === 'zh' ? '主导航' : 'Main navigation'} data-studio-section={studioMode ? 'navigation' : undefined}>{navigation.map(([path, label]) => <a aria-current={active === path ? 'page' : undefined} href={href(path, locale)}>{t[label as keyof typeof t]}</a>)}</nav>}
        <a class="locale-switch" href={counterpart} aria-label={t.language} lang={locale === 'zh' ? 'en' : 'zh-CN'}>{locale === 'zh' ? 'EN' : '中文'} <span aria-hidden="true">↗</span></a>
      </header>
      <main id="main"><slot/></main>
      {(hasFooterLeft || hasFooterRight) && <footer class="site-footer" data-studio-section={studioMode ? 'footer' : undefined}>{hasFooterLeft && <div>{footer.showMark && branding.mark && <span class="footer-seal">{branding.mark}</span>}{t.footer && <span>{t.footer}</span>}</div>}{hasFooterRight && <div>{socialLinks.map(link => <a href={link.url}>{link.label} ↗</a>)}{footer.showCopyright && copyrightName && <span>© {new Date().getFullYear()} {copyrightName}</span>}</div>}</footer>}
    </div>
  </body>
</html>
