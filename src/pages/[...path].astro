---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ArticleContents from '../components/ArticleContents.astro';
import { posts, settings, copy, href, asset, dateLabel, studioMode, type Locale } from '../lib/site';
import { resolvePresentation, visibleHomeSections } from '../lib/site-customization.mjs';
export async function getStaticPaths() {
  const entries = await posts();
  return (['zh', 'en'] as const).flatMap(locale => {
    const prefix = locale === 'en' ? 'en/' : '';
    return [
      ...['', 'archive', 'research', 'life', 'works', 'about'].map(page => ({ params: { path: `${prefix}${page}`.replace(/\/$/, '') || undefined }, props: { locale, page } })),
      ...entries.map(post => ({ params: { path: `${prefix}posts/${post.id}` }, props: { locale, page: 'post', post } })),
    ];
  });
}
const route = Astro.props as { locale?: Locale; page?: string; post?: Awaited<ReturnType<typeof posts>>[number] };
const requestedPath = (Astro.params.path ?? '').replace(/^\/+|\/+$/g, '');
const routeLocale = requestedPath === 'en' || requestedPath.startsWith('en/') ? 'en' : 'zh';
const localPath = routeLocale === 'en' ? requestedPath.replace(/^en\/?/, '') : requestedPath;
const locale = route.locale ?? routeLocale;
const page = route.page ?? (localPath.startsWith('posts/') ? 'post' : localPath);
const postId = route.post?.id ?? (page === 'post' ? localPath.slice('posts/'.length) : undefined);
const config = await settings(Astro.url);
const presentation = resolvePresentation(config);
const t = { ...copy[locale], ...presentation.text[locale] };
const entries = await posts();
const post = postId ? entries.find(entry => entry.id === postId) : undefined;
if (studioMode && !['', 'archive', 'research', 'life', 'works', 'about'].includes(page) && !(page === 'post' && post)) {
  return new Response('Page not found / 页面不存在', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}
const recentEntries = entries.filter(p => p.data.category !== 'works');
const featuredWorks = entries.filter(p => p.data.category === 'works' && p.data.featured);
const intro = config.intro[locale];
const hasIntroMargin = presentation.home.showMargin && t.margin && config.appearance.introduction !== 'compact';
const hasIntro = intro.eyebrow || intro.title || intro.body || t.about || hasIntroMargin;
const homeSections = visibleHomeSections(presentation, entries).filter(section => section.id === 'intro' ? hasIntro : section.id === 'note' ? t.footer : section.id === 'recent' ? recentEntries.length || t.empty : true);
const category = ['research', 'life', 'works'].includes(page) ? page : null;
const filtered = category ? entries.filter(p => p.data.category === category) : entries;
const title = post?.data.title ?? (page === '' ? intro.title.replace(/\n/g, ' ') : page === 'archive' ? t.writing : t[page as keyof typeof t]) ?? '';
const documentTitle = [title.trim(), config.name.trim()].filter(Boolean).join(' · ') || (locale === 'zh' ? '博客' : 'Blog');
const pageIdentity = config.name || (page === '' ? copy[locale].home : page === 'archive' ? copy[locale].writing : copy[locale][page as keyof typeof copy.zh]) || (locale === 'zh' ? '博客' : 'Blog');
const archiveEyebrow = page === 'works' ? t.worksEyebrow : t.notebook;
const archiveDescription = page === 'works' ? t.worksDesc : t.archiveDesc;
const filters = [['archive', 'all'], ['research', 'research'], ['life', 'life']].filter(([, label]) => t[label as keyof typeof t]);
const aboutParagraphs = config.about[locale].split(/\n\s*\n/).map(paragraph => paragraph.trim()).filter(Boolean);
const socialLinks = config.socialLinks.filter(link => link.label.trim());
const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
const counterpart = href(post ? `posts/${post.id}` : page, locale === 'zh' ? 'en' : 'zh');
---
<BaseLayout title={documentTitle} description={post?.data.summary || intro.body} locale={locale} page={page} counterpart={counterpart} config={config}>
  {page === '' ? <div class="home-content">
    {(!homeSections.some(section => section.id === 'intro') || !intro.title) && <h1 class="visually-hidden">{pageIdentity}</h1>}
    {homeSections.map(section => section.id === 'intro' ? <section class:list={['intro', { 'intro-margin-only': !intro.eyebrow && !intro.title && !intro.body && !t.about }]} data-studio-section={studioMode ? 'intro' : undefined}>
      {intro.eyebrow && <p class="eyebrow"><span class="tiny-line"></span>{intro.eyebrow}</p>}{intro.title && <h1>{intro.title}</h1>}{intro.body && <p class="intro-body">{intro.body}</p>}{t.about && <a class="text-link" href={href('about', locale)}>{t.about} <span aria-hidden="true">↗</span></a>}{hasIntroMargin && <span class="intro-margin" aria-hidden="true">{t.margin}</span>}
    </section> : section.id === 'recent' ? <section class="writing-section" data-studio-section={studioMode ? 'recent' : undefined}>
      {(t.latest || t.allPosts) && <div class="section-heading">{t.latest && <h2>{t.latest}<span class="section-count">{String(recentEntries.length).padStart(2, '0')}</span></h2>}{t.allPosts && <a class="text-link" href={href('archive', locale)}>{t.allPosts} <span aria-hidden="true">↗</span></a>}</div>}<PostList entries={recentEntries.slice(0, presentation.home.recentLimit)} locale={locale} labels={t}/>
    </section> : section.id === 'works' ? <section class="writing-section" data-studio-section={studioMode ? 'works' : undefined}>
      {t.selected && <div class="section-heading"><h2>{t.selected}</h2></div>}<PostList entries={featuredWorks} locale={locale} labels={t}/>
    </section> : <aside class="endnote" data-studio-section={studioMode ? 'note' : undefined}><span aria-hidden="true">✳</span><p>{t.footer}</p><span class="endnote-line"></span></aside>)}
  </div> : page === 'post' && post && Content ? <article class="article">
    {t.back && <a class="back-link" href={href('archive', locale)}>← {t.back}</a>}
    <header class="article-heading"><div class="meta">{t[post.data.category] && <><span>{t[post.data.category]}</span><span aria-hidden="true">·</span></>}<time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date, locale)}</time><span aria-hidden="true">·</span><span>{post.data.language.toUpperCase()}</span></div><h1>{post.data.title}</h1></header>
    {post.data.cover && <img class="cover" src={asset(post.data.cover)} alt={post.data.coverAlt} />}
    <ArticleContents headings={rendered?.headings ?? []} locale={locale}/>
    <div class="prose"><Content /></div>{t.back && <footer class="article-end"><span aria-hidden="true">✳</span><a class="text-link" href={href('archive', locale)}>{t.back} ↗</a></footer>}
  </article> : page === 'about' ? <section class="about-page" data-studio-section={studioMode ? 'about' : undefined}>
    {t.aboutEyebrow && <p class="eyebrow">{t.aboutEyebrow}</p>}{t.aboutTitle ? <h1>{t.aboutTitle}</h1> : <h1 class="visually-hidden">{pageIdentity}</h1>}{aboutParagraphs.length > 0 && <div class="prose">{aboutParagraphs.map(paragraph => <p>{paragraph}</p>)}</div>}
    {config.showQuote && config.quote && <blockquote>{config.quote}</blockquote>}{socialLinks.length > 0 && <div class="about-links">{socialLinks.map(link => <a class="text-link" href={link.url}>{link.label} ↗</a>)}</div>}
  </section> : <section class="archive-page">
    {(archiveEyebrow || title || archiveDescription) ? <header data-studio-section={studioMode ? (page === 'works' ? 'works' : 'labels') : undefined}>{archiveEyebrow && <p class="eyebrow">{archiveEyebrow}</p>}{title ? <h1>{title}</h1> : <h1 class="visually-hidden">{pageIdentity}</h1>}{archiveDescription && <p class="page-description">{archiveDescription}</p>}</header> : <h1 class="visually-hidden">{pageIdentity}</h1>}
    {page !== 'works' && filters.length > 0 && <nav class="filters" aria-label={locale === 'zh' ? '文章分类' : 'Categories'} data-studio-section={studioMode ? 'navigation' : undefined}>{filters.map(([path, label]) => <a href={href(path, locale)} aria-current={page === path ? 'page' : undefined}>{t[label as keyof typeof t]}</a>)}</nav>}
    <PostList entries={filtered} locale={locale} labels={t}/>{t.note && <p class="language-note">{t.note}</p>}
  </section>}
</BaseLayout>
