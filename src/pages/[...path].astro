---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ArticleContents from '../components/ArticleContents.astro';
import { posts, settings, copy, href, asset, dateLabel, studioMode, type Locale } from '../lib/site';
import { resolvePresentation, visibleHomeSections } from '../lib/site-customization.mjs';
export async function getStaticPaths() {
  const entries = await posts();
  return (['zh', 'en'] as const).flatMap(locale => {
    const prefix = locale === 'en' ? 'en/' : '';
    return [
      ...['', 'archive', 'research', 'life', 'works', 'about'].map(page => ({ params: { path: `${prefix}${page}`.replace(/\/$/, '') || undefined }, props: { locale, page } })),
      ...entries.map(post => ({ params: { path: `${prefix}posts/${post.id}` }, props: { locale, page: 'post', post } })),
    ];
  });
}
const route = Astro.props as { locale?: Locale; page?: string; post?: Awaited<ReturnType<typeof posts>>[number] };
const requestedPath = (Astro.params.path ?? '').replace(/^\/+|\/+$/g, '');
const routeLocale = requestedPath === 'en' || requestedPath.startsWith('en/') ? 'en' : 'zh';
const localPath = routeLocale === 'en' ? requestedPath.replace(/^en\/?/, '') : requestedPath;
const locale = route.locale ?? routeLocale;
const page = route.page ?? (localPath.startsWith('posts/') ? 'post' : localPath);
const postId = route.post?.id ?? (page === 'post' ? localPath.slice('posts/'.length) : undefined);
const config = await settings(Astro.url);
const presentation = resolvePresentation(config);
const t = { ...copy[locale], ...presentation.text[locale] };
const entries = await posts();
const post = postId ? entries.find(entry => entry.id === postId) : undefined;
if (studioMode && !['', 'archive', 'research', 'life', 'works', 'about'].includes(page) && !(page === 'post' && post)) {
  return new Response('Page not found / 页面不存在', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}
const recentEntries = entries.filter(p => p.data.category !== 'works');
const featuredWorks = entries.filter(p => p.data.category === 'works' && p.data.featured);
const homeSections = visibleHomeSections(presentation, entries);
const category = ['research', 'life', 'works'].includes(page) ? page : null;
const filtered = category ? entries.filter(p => p.data.category === category) : entries;
const title = post?.data.title ?? (page === '' ? config.intro[locale].title.replace(/\n/g, ' ') : page === 'archive' ? t.writing : t[page as keyof typeof t]);
const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
const counterpart = href(post ? `posts/${post.id}` : page, locale === 'zh' ? 'en' : 'zh');
---
<BaseLayout title={`${title} · ${config.name}`} description={post?.data.summary || config.intro[locale].body} locale={locale} page={page} counterpart={counterpart} config={config}>
  {page === '' ? <div class="home-content">
    {!homeSections.some(section => section.id === 'intro') && <h1 class="visually-hidden">{config.name}</h1>}
    {homeSections.map(section => section.id === 'intro' ? <section class="intro" data-studio-section={studioMode ? 'intro' : undefined}>
      {config.intro[locale].eyebrow && <p class="eyebrow"><span class="tiny-line"></span>{config.intro[locale].eyebrow}</p>}<h1>{config.intro[locale].title}</h1>{config.intro[locale].body && <p class="intro-body">{config.intro[locale].body}</p>}<a class="text-link" href={href('about', locale)}>{t.about} <span aria-hidden="true">↗</span></a>{presentation.home.showMargin && t.margin && <span class="intro-margin" aria-hidden="true">{t.margin}</span>}
    </section> : section.id === 'recent' ? <section class="writing-section" data-studio-section={studioMode ? 'recent' : undefined}>
      <div class="section-heading"><h2>{t.latest}<span class="section-count">{String(recentEntries.length).padStart(2, '0')}</span></h2><a class="text-link" href={href('archive', locale)}>{t.allPosts} <span aria-hidden="true">↗</span></a></div><PostList entries={recentEntries.slice(0, presentation.home.recentLimit)} locale={locale} labels={t}/>
    </section> : section.id === 'works' ? <section class="writing-section" data-studio-section={studioMode ? 'works' : undefined}>
      <div class="section-heading"><h2>{t.selected}</h2></div><PostList entries={featuredWorks} locale={locale} labels={t}/>
    </section> : <aside class="endnote" data-studio-section={studioMode ? 'note' : undefined}><span aria-hidden="true">✳</span><p>{t.footer}</p><span class="endnote-line"></span></aside>)}
  </div> : page === 'post' && post && Content ? <article class="article">
    <a class="back-link" href={href('archive', locale)}>← {t.back}</a>
    <header class="article-heading"><div class="meta"><span>{t[post.data.category]}</span><span>·</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date, locale)}</time><span>·</span><span>{post.data.language.toUpperCase()}</span></div><h1>{post.data.title}</h1></header>
    {post.data.cover && <img class="cover" src={asset(post.data.cover)} alt={post.data.coverAlt} />}
    <ArticleContents headings={rendered?.headings ?? []} locale={locale}/>
    <div class="prose"><Content /></div><footer class="article-end"><span aria-hidden="true">✳</span><a class="text-link" href={href('archive', locale)}>{t.back} ↗</a></footer>
  </article> : page === 'about' ? <section class="about-page" data-studio-section={studioMode ? 'about' : undefined}>
    {t.aboutEyebrow && <p class="eyebrow">{t.aboutEyebrow}</p>}<h1>{t.aboutTitle}</h1><div class="prose">{config.about[locale].split('\n\n').map(p => <p>{p}</p>)}</div>
    {config.showQuote && <blockquote>{config.quote}</blockquote>}<div class="about-links">{config.socialLinks.map(link => <a class="text-link" href={link.url}>{link.label} ↗</a>)}</div>
  </section> : <section class="archive-page">
    <header data-studio-section={studioMode ? (page === 'works' ? 'works' : 'labels') : undefined}><p class="eyebrow">{page === 'works' ? t.worksEyebrow : t.notebook}</p><h1>{title}</h1><p class="page-description">{page === 'works' ? t.worksDesc : t.archiveDesc}</p></header>
    {page !== 'works' && <nav class="filters" aria-label={locale === 'zh' ? '文章分类' : 'Categories'} data-studio-section={studioMode ? 'navigation' : undefined}>{[['archive', 'all'], ['research', 'research'], ['life', 'life']].map(([path, label]) => <a href={href(path, locale)} aria-current={page === path ? 'page' : undefined}>{t[label as keyof typeof t]}</a>)}</nav>}
    <PostList entries={filtered} locale={locale} labels={t}/><p class="language-note">{t.note}</p>
  </section>}
</BaseLayout>
