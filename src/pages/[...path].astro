---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { posts, settings, copy, href, asset, dateLabel, type Locale } from '../lib/site';
export async function getStaticPaths() {
  const entries = await posts();
  return (['zh', 'en'] as const).flatMap(locale => {
    const prefix = locale === 'en' ? 'en/' : '';
    return [
      ...['', 'archive', 'research', 'life', 'works', 'about'].map(page => ({ params: { path: `${prefix}${page}`.replace(/\/$/, '') || undefined }, props: { locale, page } })),
      ...entries.map(post => ({ params: { path: `${prefix}posts/${post.id}` }, props: { locale, page: 'post', post } })),
    ];
  });
}
const { locale, page, post } = Astro.props as { locale: Locale; page: string; post?: Awaited<ReturnType<typeof posts>>[number] };
const t = copy[locale];
const config = await settings();
const entries = await posts();
const category = ['research', 'life', 'works'].includes(page) ? page : null;
const filtered = category ? entries.filter(p => p.data.category === category) : entries;
const title = post?.data.title ?? (page === '' ? config.intro[locale].title.replace(/\n/g, ' ') : page === 'archive' ? t.writing : t[page as keyof typeof t]);
const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
const counterpart = href(post ? `posts/${post.id}` : page, locale === 'zh' ? 'en' : 'zh');
---
<BaseLayout title={`${title} · 珲`} description={post?.data.summary || config.intro[locale].body} locale={locale} page={page} counterpart={counterpart} config={config}>
  {page === '' ? <>
    <section class="intro"><p class="eyebrow"><span class="tiny-line"></span>{config.intro[locale].eyebrow}</p><h1>{config.intro[locale].title}</h1><p class="intro-body">{config.intro[locale].body}</p><a class="text-link" href={href('about', locale)}>{t.about} <span aria-hidden="true">↗</span></a><span class="intro-margin" aria-hidden="true">{locale === 'zh' ? '研究 / 生活 / 创作' : 'RESEARCH / LIFE / MAKING'}</span></section>
    <section class="writing-section"><div class="section-heading"><h2>{t.latest}<span class="section-count">{String(entries.length).padStart(2, '0')}</span></h2><a class="text-link" href={href('archive', locale)}>{t.allPosts} <span aria-hidden="true">↗</span></a></div><PostList entries={entries.filter(p => p.data.category !== 'works').slice(0, 6)} locale={locale} /></section>
    {entries.some(p => p.data.category === 'works' && p.data.featured) && <section class="writing-section"><div class="section-heading"><h2>{t.selected}</h2></div><PostList entries={entries.filter(p => p.data.category === 'works' && p.data.featured)} locale={locale}/></section>}
    <aside class="endnote"><span aria-hidden="true">✳</span><p>{t.footer}</p><span class="endnote-line"></span></aside>
  </> : page === 'post' && post && Content ? <article class="article">
    <a class="back-link" href={href('archive', locale)}>← {t.back}</a>
    <header class="article-heading"><div class="meta"><span>{t[post.data.category]}</span><span>·</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date, locale)}</time><span>·</span><span>{post.data.language.toUpperCase()}</span></div><h1>{post.data.title}</h1></header>
    {post.data.cover && <img class="cover" src={asset(post.data.cover)} alt={post.data.coverAlt} />}
    <div class="prose"><Content /></div><footer class="article-end"><span aria-hidden="true">✳</span><a class="text-link" href={href('archive', locale)}>{t.back} ↗</a></footer>
  </article> : page === 'about' ? <section class="about-page">
    <p class="eyebrow">{locale === 'zh' ? '关于这个小小的空间' : 'A little about this place'}</p><h1>{t.aboutTitle}</h1><div class="prose">{config.about[locale].split('\n\n').map(p => <p>{p}</p>)}</div>
    {config.showQuote && <blockquote>{config.quote}</blockquote>}<div class="about-links">{config.socialLinks.map(link => <a class="text-link" href={link.url}>{link.label} ↗</a>)}</div>
  </section> : <section class="archive-page">
    <p class="eyebrow">{page === 'works' ? (locale === 'zh' ? '把想法做出来' : 'FROM IDEAS TO THINGS') : t.notebook}</p><h1>{title}</h1><p class="page-description">{page === 'works' ? t.worksDesc : t.archiveDesc}</p>
    {page !== 'works' && <nav class="filters" aria-label={locale === 'zh' ? '文章分类' : 'Categories'}>{[['archive', 'all'], ['research', 'research'], ['life', 'life']].map(([path, label]) => <a href={href(path, locale)} aria-current={page === path ? 'page' : undefined}>{t[label as keyof typeof t]}</a>)}</nav>}
    <PostList entries={filtered} locale={locale}/><p class="language-note">{t.note}</p>
  </section>}
</BaseLayout>
